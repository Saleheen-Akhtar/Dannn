DirectoryIndex index.html
DirectorySlash Off
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Single-hop redirect from HTTP or non-www to https://www.yfbfitoutcontracting.com
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} !^www\.yfbfitoutcontracting\.com$ [NC]
  RewriteCond %{HTTP_HOST} ^(?:www\.)?yfbfitoutcontracting\.com$ [NC]
  RewriteRule ^(.*)$ https://www.yfbfitoutcontracting.com/$1 [R=301,L]

  # Redirect duplicate /gallery alias to canonical /photo-gallery
  RewriteRule ^gallery/?$ /photo-gallery [R=301,L]

  # 1. Serve pre-rendered route/index.html directly (e.g., /projects -> /projects/index.html)
  RewriteCond %{REQUEST_URI} !^/$
  RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
  RewriteRule ^(.+?)/?$ $1/index.html [L]

  # 2. Serve existing static files (robots.txt, sitemap.xml, llms.txt, /static/*, /assets/*) directly
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # 3. Return 404 for missing static assets instead of HTML fallback
  RewriteRule ^(assets|static)/ - [R=404,L]

  # 4. Unknown routes serve the pre-rendered 404 page with 404 status
  RewriteRule ^ /404.html [R=404,L]
</IfModule>

<IfModule mod_headers.c>
  # Security Headers
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"

  # Immutable caching for hashed Vite bundles
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Caching for static images & fonts
  <FilesMatch "\.(webp|jpg|jpeg|png|svg|woff2)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>

  # Ensure HTML documents, robots.txt, and sitemap.xml are always fresh
  <FilesMatch "\.(html|txt|xml)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>
